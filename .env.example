# Database
# These values are shared by the local Docker Compose services.
POSTGRES_DB=finsight
POSTGRES_USER=finsight
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql+psycopg://finsight:replace-me@postgres:5432/finsight

# Redis
REDIS_URL=redis://redis:6379/0

# Backend authentication
# Replace JWT_SECRET_KEY before any environment outside local development.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# AI provider
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Storage
STORAGE_PROVIDER=local
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Application
APP_ENV=development
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
